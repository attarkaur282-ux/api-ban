{
  "version": 2,
  "builds": [
    {
      "src": "start.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/register",
      "dest": "start.py"
    },
    {
      "src": "/login",
      "dest": "start.py"
    },
    {
      "src": "/attack",
      "dest": "start.py"
    },
    {
      "src": "/status",
      "dest": "start.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
